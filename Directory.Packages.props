<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The Roslyn that the shipped analyzers and code fixes are built against: the compiler of the oldest SDK that can build a project for the
         oldest supported long-term-support .NET. A compiler refuses (warning CS9057, an error when warnings are errors) an analyzer that references
         a newer Roslyn than itself, so a newer value would silently switch the analyzers off for the people on that SDK. 5.0 is the .NET 10 SDK
         (10.0.1xx) and Visual Studio 2026 (18.0). The PackageVersion entries below are for the tests and the generators, which use the newest;
         the analyzer projects override them with this property. Raise it on purpose (see docs/analyzers.md), never through a dependency update. -->
    <AnalyzerRoslynVersion>5.0.0</AnalyzerRoslynVersion>
    <!-- The analyzers are packed into the folder of that version (analyzers/dotnet/roslyn5.0/cs): the SDK passes them to a compiler of that version or
         newer, and to an older compiler it passes nothing, so there is no warning either. -->
    <AnalyzerRoslynFolder>roslyn$([System.Version]::Parse('$(AnalyzerRoslynVersion)').ToString(2))</AnalyzerRoslynFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Ardalis.Result" Version="10.1.0" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageVersion Include="ErrorOr" Version="2.1.1" />
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="Funcky" Version="3.8.0" />
    <PackageVersion Include="LanguageExt.Core" Version="4.4.9" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="Optional" Version="4.0.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
