<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A struct-based, allocation-free-on-success Result type for .NET with a safe default, one aggregating Error, and complete Task and ValueTask railway extensions. No dependencies outside the BCL.</Description>
    <PackageTags>result;error-handling;railway-oriented-programming;functional;struct;async;valuetask;analyzers</PackageTags>
    <RootNamespace>$(ProductPrefix)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Result.Analyzers\Result.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\Result.Analyzers.CodeFixes\Result.Analyzers.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\Result.Analyzers\bin\$(Configuration)\netstandard2.0\$(ProductPrefix).Result.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/$(AnalyzerRoslynFolder)/cs" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\Result.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\$(ProductPrefix).Result.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/$(AnalyzerRoslynFolder)/cs" Visible="false" />
  </ItemGroup>

</Project>
