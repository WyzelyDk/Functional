<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A struct-based, allocation-free Maybe type for .NET with a safe default (none), explicit absence instead of null, and complete Task and ValueTask railway extensions. No dependencies outside the BCL.</Description>
    <PackageTags>maybe;option;optional;null-handling;railway-oriented-programming;functional;struct;async;valuetask;analyzers</PackageTags>
    <RootNamespace>$(ProductPrefix)</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maybe.Analyzers\Maybe.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\Maybe.Analyzers.CodeFixes\Maybe.Analyzers.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\Maybe.Analyzers\bin\$(Configuration)\netstandard2.0\$(ProductPrefix).Maybe.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/$(AnalyzerRoslynFolder)/cs" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\Maybe.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\$(ProductPrefix).Maybe.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/$(AnalyzerRoslynFolder)/cs" Visible="false" />
  </ItemGroup>

</Project>
