<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>$(ProductPrefix).SharedTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NestedCallFinder reads C# source with Roslyn. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public API dump that the tests of the packages use; its own tests are here. -->
    <Compile Include="..\ApiSurface\*.cs" Link="ApiSurface\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\Shared.csproj" />

    <!-- The shared helpers are internal and live in this namespace. -->
    <Using Include="$(ProductPrefix).Internal" />
  </ItemGroup>

</Project>