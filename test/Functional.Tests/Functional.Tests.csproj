<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <!-- The tests of the umbrella package are named after it: Wyzely.Functional.Tests. -->
    <AssemblyName>$(ProductPrefix).Tests</AssemblyName>
    <RootNamespace>$(ProductPrefix).Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ArgumentTesting\*.cs" Link="ArgumentTesting\%(Filename)%(Extension)" />
    <Compile Include="..\ApiSurface\*.cs" Link="ApiSurface\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Functional\Functional.csproj" />
  </ItemGroup>

</Project>