<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <!-- A namespace Wyzely.Functional.Maybe.* would clash with the type Wyzely.Functional.Maybe, so the tests use Wyzely.Functional.MaybeTests. -->
    <RootNamespace>$(ProductPrefix).MaybeTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ArgumentTesting\*.cs" Link="ArgumentTesting\%(Filename)%(Extension)" />
    <Compile Include="..\ApiSurface\*.cs" Link="ApiSurface\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maybe\Maybe.csproj" />
    <ProjectReference Include="..\..\src\Maybe.CodeGeneration\Maybe.CodeGeneration.csproj" />
  </ItemGroup>

</Project>
