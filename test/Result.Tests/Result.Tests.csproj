<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A namespace Wyzely.Functional.Result.* would clash with the type Wyzely.Functional.Result. -->
    <RootNamespace>$(ProductPrefix).ResultTests</RootNamespace>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Result\Result.csproj" />
    <ProjectReference Include="..\..\src\Result.CodeGeneration\Result.CodeGeneration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ArgumentTesting\*.cs" Link="ArgumentTesting\%(Filename)%(Extension)" />
    <Compile Include="..\ApiSurface\*.cs" Link="ApiSurface\%(Filename)%(Extension)" />
    <Compile Include="..\PendingTesting\*.cs" Link="PendingTesting\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="$(ProductPrefix).PendingTesting" />
  </ItemGroup>

</Project>
