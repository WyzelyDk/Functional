<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProductPrefix>Wyzely.Functional</ProductPrefix>
    <AssemblyName>$(ProductPrefix).$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(ProductPrefix).$(MSBuildProjectName)</RootNamespace>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsTestProject>
    <IsToolProject>false</IsToolProject>
    <IsToolProject Condition="$(MSBuildProjectName.EndsWith('CodeGeneration')) or $(MSBuildProjectName.EndsWith('Benchmarks')) or $(MSBuildProjectName.EndsWith('Samples')) or '$(MSBuildProjectName)' == 'Shared'">true</IsToolProject>
    <IsAnalyzerProject>false</IsAnalyzerProject>
    <IsAnalyzerProject Condition="$(MSBuildProjectName.EndsWith('Analyzers')) or $(MSBuildProjectName.EndsWith('CodeFixes'))">true</IsAnalyzerProject>
    <IsLibraryProject>true</IsLibraryProject>
    <IsLibraryProject Condition="'$(IsTestProject)' == 'true' or '$(IsToolProject)' == 'true' or '$(IsAnalyzerProject)' == 'true'">false</IsLibraryProject>
    <!-- The tools whose logic decides what the libraries contain: their coverage is measured, unlike that of the tests, samples and benchmarks. -->
    <IsMeasuredToolProject>false</IsMeasuredToolProject>
    <IsMeasuredToolProject Condition="$(MSBuildProjectName.EndsWith('CodeGeneration')) or '$(MSBuildProjectName)' == 'Shared'">true</IsMeasuredToolProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLibraryProject)' == 'true'">
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <Authors>Jonas B. Rasmussen</Authors>
    <Company>Wyzely</Company>
    <Product>Wyzely Functional</Product>
    <Copyright>© Wyzely $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/WyzelyDk/Functional</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WyzelyDk/Functional</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsToolProject)' == 'true' or '$(IsAnalyzerProject)' == 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncFixer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

  </ItemGroup>

  <ItemGroup Condition="'$(IsLibraryProject)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MinVer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <InternalsVisibleTo Include="$(AssemblyName).Tests" />

    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />

    <Compile Include="$(MSBuildThisFileDirectory)src\Shared\Internal\*.cs" LinkBase="Internal" />

    <Using Include="$(ProductPrefix).Internal" />
  </ItemGroup>

  <!-- The tests, the samples and the benchmarks are not measured. The libraries, the analyzers (netstandard2.0) and the measured tools are. -->
  <ItemGroup Condition="'$(IsLibraryProject)' == 'false' and '$(IsMeasuredToolProject)' == 'false' and '$(TargetFramework)' != 'netstandard2.0'">
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />

    <Using Include="Xunit" />
  </ItemGroup>

</Project>
